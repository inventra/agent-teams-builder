{
  "contract_version": 1,
  "fields": [
    {
      "name": "execution_mode",
      "label": "執行方式",
      "type": "string",
      "required": true,
      "help": "save：建立並儲存；prepare：只預填。按本次授權選擇。",
      "enum": [
        "save",
        "prepare"
      ]
    },
    {
      "name": "company",
      "label": "公司全名",
      "type": "string",
      "required": true,
      "help": "使用本次明確指定或已確認的公司設定，不可從影片示範擅自沿用。"
    },
    {
      "name": "document_type",
      "label": "單別",
      "type": "string",
      "required": true,
      "help": "已校準的一般費用請款單（員工）。",
      "enum": [
        "I502"
      ]
    },
    {
      "name": "document_date",
      "label": "單據日期",
      "type": "date",
      "required": true,
      "help": ""
    },
    {
      "name": "claim_date",
      "label": "請款日期",
      "type": "date",
      "required": true,
      "help": ""
    },
    {
      "name": "applicant",
      "label": "申請人代碼",
      "type": "string",
      "required": true,
      "help": ""
    },
    {
      "name": "counterparty",
      "label": "對象代碼",
      "type": "string",
      "required": true,
      "help": ""
    },
    {
      "name": "department",
      "label": "預期部門代號",
      "type": "string",
      "required": true,
      "help": "ERP 依申請人帶出；程式核對是否符合。"
    },
    {
      "name": "factory",
      "label": "預期廠別",
      "type": "string",
      "required": true,
      "help": "ERP 帶入後核對；本機歷史校準為 1，需明確確認。"
    },
    {
      "name": "currency",
      "label": "幣別",
      "type": "string",
      "required": true,
      "help": "",
      "enum": [
        "NTD"
      ]
    },
    {
      "name": "rate",
      "label": "匯率",
      "type": "string",
      "required": true,
      "help": "",
      "enum": [
        "1"
      ]
    },
    {
      "name": "bank_code",
      "label": "銀行行號",
      "type": "string",
      "required": true,
      "help": "",
      "pattern": "\\d{3}",
      "pattern_message": "請填 3 位數字，例如 003，保留前導零。"
    },
    {
      "name": "bank_account",
      "label": "銀行帳號",
      "type": "string",
      "required": true,
      "help": "",
      "pattern": "\\d+",
      "pattern_message": "請使用數字字串，保留前導零。"
    },
    {
      "name": "payment_date",
      "label": "預計付款日",
      "type": "date",
      "required": true,
      "help": ""
    },
    {
      "name": "payment_condition",
      "label": "付款條件代碼",
      "type": "string",
      "required": true,
      "help": "沒有指定時先確認是否留空，不默默保留 ERP 值。",
      "allow_empty": true
    },
    {
      "name": "cash_date",
      "label": "預計兌現日",
      "type": "date",
      "required": true,
      "help": "不適用請明確選擇留空。",
      "allow_empty": true
    },
    {
      "name": "note",
      "label": "表頭備註",
      "type": "string",
      "required": true,
      "help": ""
    },
    {
      "name": "receipt_count",
      "label": "憑證張數",
      "type": "integer",
      "required": true,
      "help": "",
      "minimum": 0
    },
    {
      "name": "detail.expense_code",
      "label": "費用代號",
      "type": "string",
      "required": true,
      "help": "依本次用途及已核對清單選擇，例如餐費 2007；不猜代碼。"
    },
    {
      "name": "detail.summary",
      "label": "明細摘要",
      "type": "string",
      "required": true,
      "help": "若與備註相同，依本次指示填相同文字。"
    },
    {
      "name": "detail.amount",
      "label": "請款金額",
      "type": "number",
      "required": true,
      "help": "",
      "exclusive_minimum": 0,
      "decimals": 2
    },
    {
      "name": "detail.voucher",
      "label": "憑證類別",
      "type": "string",
      "required": true,
      "help": "receipt＝收據；發票需另建流程。",
      "enum": [
        "receipt"
      ]
    },
    {
      "name": "detail.receipt_number",
      "label": "收據號碼",
      "type": "string",
      "required": true,
      "help": "現有已驗證流程僅支援無號碼；有號碼須先校準讀回。",
      "enum": [
        ""
      ],
      "allow_empty": true
    },
    {
      "name": "detail.project",
      "label": "專案代號",
      "type": "string",
      "required": true,
      "help": "區分大小寫，例如 ZZ。"
    }
  ],
  "rules": [],
  "fixed_behavior": {
    "payment_method": "2.轉帳",
    "counterparty_type": "1.人員",
    "rows": 1
  },
  "outputs": [
    "document_number",
    "names",
    "expense_account",
    "tax",
    "totals",
    "journal",
    "review_images"
  ],
  "system_generated": [
    "request_id"
  ],
  "preconditions": [
    "ERP 已登入",
    "資料完整後才可定位或開啟 PCMI10",
    "版本 iGP2.0 16.0.2.1"
  ]
}
